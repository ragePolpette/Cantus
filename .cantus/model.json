  "rules": {
    "allow": {
      "interface": [
        "interface",
        "application",
        "domain"
      ],
      "application": [
        "application",
        "domain",
        "infrastructure"
      ],
      "domain": [
        "domain"
      ],
      "infrastructure": [
        "infrastructure",
        "domain"
      ]
    }
  }
}
