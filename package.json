{
  "name": "cantus",
  "version": "0.2.0",
  "description": "A map of your codebase for developers and coding agents: blocks, APIs, callers, and per-block context",
  "license": "Apache-2.0",
  "homepage": "https://github.com/ragePolpette/Cantus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ragePolpette/Cantus.git"
  },
  "bugs": {
    "url": "https://github.com/ragePolpette/Cantus/issues"
  },
  "author": "Gianmarco Bastianelli",
  "keywords": [
    "architecture",
    "codebase-map",
    "mcp",
    "claude-code",
    "coding-agents",
    "context",
    "cli"
  ],
  "type": "module",
  "bin": {
    "cantus": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "grammars",
    "licenses",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build --silent && node --test",
    "check:package": "node scripts/check-package.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "verify:release": "npm run typecheck && npm test && npm run check:package && npm run smoke:package",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify:release"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.34.6",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.287",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@openai/codex-sdk": "0.167.0",
    "@typescript/typescript6": "^6.0.2",
    "oxc-parser": "^0.151.0",
    "oxc-resolver": "^11.24.2",
    "oxc-transform": "^0.151.0",
    "vscode-jsonrpc": "8.2.1",
    "web-tree-sitter": "^0.27.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
